+// Fixed two-block unkeyed Blake2b-512 used between RandomX programs.
+static int blake2b_256_64_avx2(void* out_ptr, const void* in_ptr) {
+  const uint8_t* in = (const uint8_t*)in_ptr;
+  __m256i a = XOR(LOAD(&blake2b_IV[0]), _mm256_set_epi64x(0, 0, 0, 0x01010040UL));
+  __m256i b = LOAD(&blake2b_IV[4]);
+  BLAKE2B_COMPRESS_V1(a, b, in, 128, 0, 0, 0);
+  BLAKE2B_COMPRESS_V1(a, b, in + 128, 256, 0, UINT64_MAX, 0);
+  STOREU((uint8_t*)out_ptr, a);
+  STOREU((uint8_t*)out_ptr + 32, b);
+  _mm256_zeroupper();
+  return 0;
+}
+
 int blake2b_avx2(void* out_ptr, size_t outlen, const void* in_ptr, size_t inlen) {
+  if (inlen == 256 && outlen == 64) {
+    return blake2b_256_64_avx2(out_ptr, in_ptr);
+  }
+
   const __m256i parameter_block = _mm256_set_epi64x(0, 0, 0, 0x01010000UL | (uint32_t)outlen);
   ALIGN(64) uint8_t buffer[BLAKE2B_BLOCKBYTES];
   __m256i a = XOR(LOAD(&blake2b_IV[0]), parameter_block);
