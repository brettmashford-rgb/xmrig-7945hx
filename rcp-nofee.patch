diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4b36a8d..1c98ebd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,20 @@
 cmake_minimum_required(VERSION 3.10)
 project(xmrig)
 
+# Experimental hardware-AES scratchpad prefetch tuning; upstream default.
+set(RX_AES_PREFETCH_DISTANCE "7168" CACHE STRING "RandomX hardware AES prefetch distance in bytes (256..8192, multiple of 256)")
+if (NOT RX_AES_PREFETCH_DISTANCE MATCHES "^[0-9]+$")
+    message(FATAL_ERROR "RX_AES_PREFETCH_DISTANCE must be an integer")
+endif()
+if (RX_AES_PREFETCH_DISTANCE LESS 256 OR RX_AES_PREFETCH_DISTANCE GREATER 8192)
+    message(FATAL_ERROR "RX_AES_PREFETCH_DISTANCE must be between 256 and 8192")
+endif()
+math(EXPR RX_AES_PREFETCH_REMAINDER "${RX_AES_PREFETCH_DISTANCE} % 256")
+if (NOT RX_AES_PREFETCH_REMAINDER EQUAL 0)
+    message(FATAL_ERROR "RX_AES_PREFETCH_DISTANCE must be a multiple of 256")
+endif()
+add_definitions(-DXMRIG_RX_AES_PREFETCH_DISTANCE=${RX_AES_PREFETCH_DISTANCE})
+
 option(WITH_HWLOC           "Enable hwloc support" ON)
 option(WITH_CN_LITE         "Enable CryptoNight-Lite algorithms family" ON)
 option(WITH_CN_HEAVY        "Enable CryptoNight-Heavy algorithms family" ON)
